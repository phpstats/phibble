{
    "name": "phpstats/phibble",
    "description": "A typed, immutable in-memory data frame for PHP.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "symfony/polyfill-php84": "^1.31"
    },
    "require-dev": {
        "illuminate/database": "^12.0",
        "pestphp/pest": "^4.0",
        "phpstats/phiz": "dev-main",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "suggest": {
        "ext-pdo_sqlite": "Used by the test suite for the PDO source",
        "illuminate/database": "Laravel integration: Collection::toDataFrame() and query builder ->phibble() / ->toDataFrame() macros (auto-discovered)",
        "ext-phit": "Native CSV reading (Phit\\read_csv) and model fitting, from phpstats/phit",
        "ext-php_polars": "The Polars backend (Phibble\\Polars\\PolarsTable), from phpstats/phpolars"
    },
    "autoload": {
        "psr-4": {
            "Phibble\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Expr/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Phibble\\Bench\\": "bench/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Phibble\\Laravel\\PhibbleServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phpstats/phiz"
        }
    ],
    "scripts": {
        "lint": "phpcs"
    }
}
