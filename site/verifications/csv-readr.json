{
    "title": "CSV reading",
    "label": "CSV reading",
    "kind": "reference",
    "checked": "Column names, guessed and declared types, values, factor levels, and parsing problems for 39 CSV files, read by each of three CSV readers. CSV text written by toCsv() and CsvWriter::formatDouble().",
    "description": "tests/r/io.R reads each case with readr::read_delim() and records names, types, values, and problems; write cases add readr::format_csv() output. tests/IoTest.php reads the same files with identical options. Fixtures regenerated with the listed R versions on 2026-11-01; output byte-identical to the committed files.",
    "reference": "readr 2.2.0 read_delim(), problems(), and format_csv(), on R 4.6.1",
    "versions": {
        "R": "4.6.1",
        "readr": "2.2.0",
        "vroom": "1.7.1",
        "jsonlite": "2.0.0",
        "phit": "0.4.4"
    },
    "inputs": [
        {
            "name": "CSV cases",
            "detail": "35 CSV files and the readr options for each",
            "url": "tests/fixtures/io/cases.json"
        },
        {
            "name": "readr results",
            "detail": "One JSON file per case, written by tests/r/io.R",
            "url": "tests/fixtures/io/expected"
        }
    ],
    "comparison": [
        {
            "id": "read",
            "applies_to": "Names, types, levels, values, and problem rows; doubles parsed from readr's shortest round-trip text, NA in identical positions",
            "kind": "exact"
        },
        {
            "id": "write",
            "applies_to": "Written CSV text; byte for byte",
            "kind": "exact"
        }
    ],
    "known_differences": [
        "Whole-number columns guess as int; readr guesses double. These columns are compared as doubles.",
        "empty_rows: readr numbers an empty line's problem one lower than other rows. Problem row numbers are not compared for this case."
    ],
    "data": "tests/fixtures/io",
    "reproduce": [
        "Rscript tests/r/io.R",
        "php vendor/bin/pest tests/IoTest.php"
    ],
