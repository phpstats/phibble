{
    "package": "phibble",
    "title": "phibble",
    "tagline": "A typed, immutable data frame for PHP, with readr-style input and output.",
    "summary": [
        "Load, transform, and summarize typed data frames in PHP. Tables are immutable, and `null` represents missing data.",
        "Names and semantics follow R's tibble, readr, and dplyr. The same methods run in memory, in SQLite, PostgreSQL, or MySQL, or in Polars."
    ],
    "install": [
        "composer require phpstats/phibble"
    ],
    "php": [
        "8.3",
        "8.4",
        "8.5"
    ],
    "platforms": [
        "Linux",
        "macOS"
    ],
    "requires": [
        "mbstring extension",
        "PDO extension"
    ],
    "optional": [
        {
            "name": "phit extension",
            "for": "native CSV reading"
        },
        {
            "name": "php_polars extension",
            "for": "the Polars backend"
        },
        {
            "name": "illuminate/database",
            "for": "the Laravel macros"
        }
    ],
    "build": [],
    "quickstart": "getting-started",
    "installation": "getting-started#installation",
    "repository": "https://github.com/phpstats/phibble",
    "example": {
        "chain": "use function Phibble\\Expr\\{col, desc, mean, n, sum};\n\n$orders = \\Phibble\\DataFrame::fromCsv('orders.csv', types: [\n    'channel' => 'factor',\n    'coupon' => 'bool',\n    'returned' => 'bool',\n]);\n\necho $orders\n    ->filter(col('returned')->not())\n    ->mutate(['item_price' => col('total')->div(col('items'))])\n    ->groupBy(['channel'])\n    ->summarize([\n        'orders' => n(),\n        'revenue' => sum(col('total')),\n        'item_price' => mean(col('item_price')),\n        'coupons' => mean(col('coupon')),\n    ], groups: 'drop')\n    ->arrange([desc(col('revenue'))]);",
        "output": "# A tibble: 3 × 5\n  channel orders revenue item_price coupons\n  <fct>    <int>   <dbl>      <dbl>   <dbl>\n1 web        211  19450.       32.9  0.327 \n2 store      109  12065.       41.8  0.174 \n3 phone       65   9024.       51.2  0.0615"
    },
    "examples": [
        {
            "path": "examples/read-a-csv",
            "title": "Read a CSV file into a typed table",
            "description": "Infer column types, declare a factor, and read missing values."
        },
        {
            "path": "examples/database-table",
            "title": "Query a database table",
            "description": "Build a grouped summary in SQL, inspect the query, and collect the result.",
            "also": [
                "phplyr"
            ]
        }
    ],
