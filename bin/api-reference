#!/usr/bin/env php
<?php

/*
 * Writes the Functions and methods reference in docs/reference/ from the
 * public API, by reflection and docblocks.
 *
 * Usage: bin/api-reference [--check]
 *
 * The callables are every function in the Phibble and Phibble\Expr
 * namespaces and every public method of the classes in CLASSES, less those
 * marked @internal and those in EXCLUDED. Each must be placed on a page
 * below, and each must have a docblock summary; otherwise the script lists
 * them and fails. --check fails when the pages on disk differ from what the
 * script would write.
 */

declare(strict_types=1);

use Phibble\Contracts\Table;

$root = dirname(__DIR__);
chdir($root);
require 'vendor/autoload.php';
require_once 'src/functions.php';
require_once 'src/Expr/helpers.php';

const TABLES = ['DataFrame' => Phibble\DataFrame::class, 'SqlTable' => Phibble\Sql\SqlTable::class, 'PolarsTable' => Phibble\Polars\PolarsTable::class];
const CLASSES = [
    'Expr' => Phibble\Expr\Expr::class,
    'Row' => Phibble\Row::class,
    'Type' => Phibble\Type::class,
    'Time' => Phibble\Time::class,
    'Clock' => Phibble\Expr\Clock::class,
    'NameRepair' => Phibble\NameRepair::class,
    'Dialect' => Phibble\Sql\Dialect::class,
    'PhibbleServiceProvider' => Phibble\Laravel\PhibbleServiceProvider::class,
];
/** Public methods left out of the reference, with the reason. */
const EXCLUDED = [
    'offsetExists' => 'ArrayAccess: $df[\'name\'] and $row[\'name\'] read a column or value; writing throws, because tables are immutable.',
    'offsetGet' => 'ArrayAccess, as above.',
    'offsetSet' => 'ArrayAccess, as above.',
    'offsetUnset' => 'ArrayAccess, as above.',
    'getIterator' => 'IteratorAggregate: foreach over a table yields a Row per row.',
    'DataFrame::storage' => 'Returns the internal column storage.',
    'Time::jsonSerialize' => 'JsonSerializable: a time encodes as its HH:MM:SS text.',
    'Time::__toString' => 'Stringable: a time casts to its HH:MM:SS text.',
    'Type::cases' => 'Built-in enum method.',
    'Type::from' => 'Built-in enum method.',
    'Type::tryFrom' => 'Built-in enum method.',
    'PhibbleServiceProvider::boot' => 'Laravel service provider hook.',
    'Dialect::*' => 'SQL compiler hooks that each dialect class implements; only Dialect::for() and Dialect::tryFor() are for applications.',
];

/*
 * Pages and their sections. Keys:
 *   tibble          a function in Phibble, or in Phibble\Expr for expression pages
 *   DataFrame::x    a static method
 *   ->x             an instance method of the table classes
 *   Expr->x         an instance method of another class
 *   @macro          a Laravel macro, described in MACROS
 */
$pages = [
    'creating' => ['Creating and loading tables', 'Functions and static methods that create a table from PHP values, files, queries, or other tables.', [
