#!/usr/bin/env php
<?php

/*
 * Runs the test suite and writes the verification records in
 * site/verifications/, in the format of phpstats.org's
 * docs/evidence-records.md.
 *
 * Usage: bin/verify [--php="php85 -d extension=/path/to/libphit.so"]
 *
 * Each record case is one Pest test, read from the suite's JUnit and TeamCity
 * logs, so every status is the suite's own. Optional parts run as the suite
 * runs them: PostgreSQL and MySQL when PHIBBLE_TEST_PGSQL and
 * PHIBBLE_TEST_MYSQL are set, Polars when php_polars is loaded, and the phit
 * reader when phit is loaded. A test that does not run is recorded as skipped
 * with the suite's reason.
 */

declare(strict_types=1);

$root = dirname(__DIR__);
chdir($root);

$options = getopt('', ['php:']);
$php = $options['php'] ?? (getenv('PHP') ?: escapeshellarg(PHP_BINARY));

// ---------------------------------------------------------------------
// Run the suite
// ---------------------------------------------------------------------

$logs = sys_get_temp_dir().'/phibble-verify-'.getmypid();
@mkdir($logs);
$junit = "{$logs}/junit.xml";
$teamcity = "{$logs}/teamcity.txt";
exec("{$php} vendor/bin/pest --colors=never --log-junit ".escapeshellarg($junit).' --log-teamcity '.escapeshellarg($teamcity).' 2>&1', $output, $code);
$summary = array_values(array_filter($output, fn ($l) => str_contains($l, 'Tests:')));
fwrite(STDERR, trim($summary[0] ?? 'The suite printed no summary.')."\n");
if (! is_file($junit)) {
    fwrite(STDERR, implode("\n", array_slice($output, -20))."\n");
    exit(1);
}

$probe = <<<'PHP'
    $os = match (PHP_OS_FAMILY) {
        'Linux' => 'Linux, '.(parse_ini_file('/etc/os-release')['PRETTY_NAME'] ?? 'unknown').' ('.php_uname('m').')',
        'Darwin' => 'macOS '.trim((string) shell_exec('sw_vers -productVersion')).' ('.php_uname('m').')',
        default => PHP_OS_FAMILY.' ('.php_uname('m').')',
    };
    echo json_encode([
        'PHP' => PHP_VERSION,
        'phit' => phpversion('phit') ?: null,
        'php_polars' => phpversion('php_polars') ?: null,
        'SQLite' => (new PDO('sqlite::memory:'))->query('SELECT sqlite_version()')->fetchColumn(),
        'os' => $os,
    ]);
    PHP;
$runtime = json_decode((string) shell_exec("{$php} -r ".escapeshellarg($probe)), true);

$databases = [];
foreach (['pgsql' => ['PostgreSQL', 'SHOW server_version'], 'mysql' => ['MySQL', 'SELECT VERSION()']] as $driver => [$label, $sql]) {
    $env = 'PHIBBLE_TEST_'.strtoupper($driver);
    if (getenv($env)) {
        $pdo = new PDO(getenv($env), getenv("{$env}_USER") ?: null, getenv("{$env}_PASSWORD") ?: null);
        $databases[$label] = (string) $pdo->query($sql)->fetchColumn();
    }
}

$commit = trim((string) shell_exec('git rev-parse --short HEAD'));
if (trim((string) shell_exec('git status --porcelain -- src tests composer.lock')) !== '') {
    $commit .= '-dirty';
    fwrite(STDERR, "src or tests has uncommitted changes; the records name {$commit}.\n");
}
$environment = ['date' => gmdate('Y-m-d'), 'commit' => $commit, 'php' => $runtime['PHP'], 'os' => $runtime['os']];
$r = json_decode((string) file_get_contents('tests/r/versions.json'), true);

// ---------------------------------------------------------------------
// Read the logs
// ---------------------------------------------------------------------

/** Letters and digits only, to match JUnit names with TeamCity's. */
$key = fn (string $class, string $name) => $class.'|'.preg_replace('/[^A-Za-z0-9]+/', '', $name);

$skipReasons = [];
foreach (file($teamcity) ?: [] as $line) {
    if (preg_match("/^##teamcity\\[testIgnored name='(.*?)' message='(.*?)'/", $line, $m)) {
        $unescape = fn (string $s) => strtr($s, ["|'" => "'", '||' => '|', '|n' => "\n", '|r' => "\r", '|[' => '[', '|]' => ']']);
        if (preg_match("/\\\\P\\\\Tests\\\\([A-Za-z0-9\\\\]+)::/", $line, $c)) {
            $name = preg_replace('/^__pest_evaluable_/', '', $unescape($m[1]));
            $skipReasons[$key('Tests\\'.$c[1], $name)] = $unescape($m[2]);
        }
    }
}

$tests = [];
foreach (simplexml_load_file($junit)->xpath('//testcase') as $case) {
    $name = (string) $case['name'];
    $class = (string) $case['class'];
    [$description, $data] = array_pad(explode(' with data set ', $name, 2), 2, null);
    $labels = [];
    if ($data !== null) {
        foreach (explode(' / ', substr($data, 1, -1)) as $part) {
            $labels[] = preg_match('/^dataset "(.*)"$/s', $part, $m) ? $m[1]
                : (preg_match("/^\\('(.*)'\\)$/s", $part, $m) ? $m[1] : trim($part, '()'));
        }
    }
    $failure = $case->failure ?? $case->error ?? null;
    $status = match (true) {
        isset($case->failure) || isset($case->error) => 'fail',
        isset($case->skipped) => 'skipped',
        default => 'pass',
    };
    $reason = match ($status) {
        'fail' => trim(strtok(trim((string) ($case->failure ?? $case->error)), "\n") ?: 'The test failed.'),
        'skipped' => $skipReasons[$key($class, $name)] ?? 'The suite skipped this test without a reason.',
        default => null,
    };
    $tests[] = [
        'file' => explode('::', (string) $case['file'])[0],
        'test' => preg_replace('/^it /', '', $description),
        'labels' => $labels,
        'status' => $status,
        'reason' => $reason,
    ];
}

// ---------------------------------------------------------------------
// Topics
// ---------------------------------------------------------------------

$json = fn (string $path) => json_decode((string) file_get_contents($path), true);
$exprExpected = $json('tests/fixtures/expr/expected.json');
$lsExpected = $json('tests/fixtures/expr/lubridate_stringr.json');
$joinExpected = $json('tests/fixtures/joins/expected.json');
$pivotCases = $json('tests/fixtures/pivot/cases.json');
$typeExpected = $json('tests/fixtures/expr/types.json');
$drivers = ['sqlite' => 'SQLite', 'pgsql' => 'PostgreSQL', 'mysql' => 'MySQL'];
$readers = ['php' => 'PHP reader', 'native (emulated)' => 'phit reader, emulated in PHP', 'native (phit)' => 'phit reader'];
$rVersions = fn (string ...$names) => array_intersect_key($r['versions'], array_flip(['R', ...$names, 'jsonlite']));
$regenerated = "Fixtures regenerated with the listed R versions on {$r['checked']}; output byte-identical to the committed files.";
$backendVersions = function () use ($runtime, $databases) {
    return array_filter(['PHP' => $runtime['PHP'], 'SQLite' => $runtime['SQLite']] + $databases + ['php_polars' => $runtime['php_polars']]);
};
$backendOf = fn (array $t) => match (true) {
    str_starts_with($t['file'], 'tests/Polars/') => 'Polars',
    str_starts_with($t['file'], 'tests/Sql') => $drivers[$t['labels'][0]],
    default => 'DataFrame',
};
$caseLabel = fn (array $t) => end($t['labels']);
$suite = 'php vendor/bin/pest';
$withDatabases = 'PHIBBLE_TEST_PGSQL="pgsql:host=127.0.0.1;port=5432;dbname=postgres" PHIBBLE_TEST_PGSQL_USER=postgres PHIBBLE_TEST_MYSQL="mysql:host=127.0.0.1;port=3306" PHIBBLE_TEST_MYSQL_USER=root';
$rounded = 'Column values; numbers rounded to 9 decimal places with PHP round() on both sides, Inf, -Inf, and NaN read as NA, and NA in identical positions';

$topics = [
    'print-tibble' => [
        'title' => 'Printing',
        'label' => 'Printing',
        'kind' => 'reference',
        'checked' => 'Printed output of echo, format(), and glimpse() for 38 tables: numeric magnitudes and rounding, dates, factors, list-columns, grouped, rowwise, wide, and empty tables.',
        'description' => 'tests/r/print.R writes tibble\'s output for each table to tests/fixtures/print. tests/PrintTest.php builds the same tables in phibble and compares the text.',
        'reference' => "tibble {$r['versions']['tibble']} and pillar {$r['versions']['pillar']} print() and glimpse(), on R {$r['versions']['R']}",
        'versions' => $rVersions('tibble', 'pillar', 'dplyr') + ['PHP' => $runtime['PHP']],
        'inputs' => [['name' => 'print cases', 'detail' => 'Identical tables in tests/PrintTest.php and tests/r/print.R', 'url' => 'tests/r/print.R']],
        'comparison' => [['id' => 'text', 'applies_to' => 'Printed text; byte for byte', 'kind' => 'exact']],
        'data' => 'tests/fixtures/print',
        'reproduce' => ['Rscript tests/r/print.R', "{$suite} tests/PrintTest.php"],
        'match' => fn (array $t) => $t['file'] === 'tests/PrintTest.php' ? [
            'name' => $t['labels'] === [] ? $t['test'] : $caseLabel($t),
            'quantity' => match (true) {
                str_starts_with($t['test'], 'glimpses') => 'glimpse()',
                $t['labels'] !== [] => 'print',
                default => null,
            },
            'rule' => 'text',
        ] : null,
    ],
    'csv-readr' => [
        'title' => 'CSV reading',
        'label' => 'CSV reading',
        'kind' => 'reference',
        'checked' => 'Column names, guessed and declared types, values, factor levels, and parsing problems for 39 CSV files, read by each of three CSV readers. CSV text written by toCsv() and CsvWriter::formatDouble().',
        'description' => 'tests/r/io.R reads each case with readr::read_delim() and records names, types, values, and problems; write cases add readr::format_csv() output. tests/IoTest.php reads the same files with identical options.',
        'reference' => "readr {$r['versions']['readr']} read_delim(), problems(), and format_csv(), on R {$r['versions']['R']}",
        'versions' => $rVersions('readr', 'vroom') + array_filter(['phit' => $runtime['phit']]),
        'inputs' => [
            ['name' => 'CSV cases', 'detail' => '35 CSV files and the readr options for each', 'url' => 'tests/fixtures/io/cases.json'],
            ['name' => 'readr results', 'detail' => 'One JSON file per case, written by tests/r/io.R', 'url' => 'tests/fixtures/io/expected'],
        ],
        'comparison' => [
            ['id' => 'read', 'applies_to' => 'Names, types, levels, values, and problem rows; doubles parsed from readr\'s shortest round-trip text, NA in identical positions', 'kind' => 'exact'],
            ['id' => 'write', 'applies_to' => 'Written CSV text; byte for byte', 'kind' => 'exact'],
        ],
        'known_differences' => [
            'Whole-number columns guess as int; readr guesses double. These columns are compared as doubles.',
            'empty_rows: readr numbers an empty line\'s problem one lower than other rows. Problem row numbers are not compared for this case.',
        ],
        'data' => 'tests/fixtures/io',
        'reproduce' => ['Rscript tests/r/io.R', "{$suite} tests/IoTest.php"],
        'match' => fn (array $t) => match (true) {
            $t['file'] !== 'tests/IoTest.php' => null,
            $t['test'] === 'reads CSV like readr' => ['name' => $t['labels'][0], 'implementation' => $readers[$t['labels'][1]], 'quantity' => 'read', 'rule' => 'read'],
            in_array($t['test'], ['writes CSV like readr', 'formats doubles like write_csv'], true) => ['name' => $t['test'], 'quantity' => 'write', 'rule' => 'write'],
            default => null,
        },
    ],
    'expressions-dplyr' => [
        'title' => 'Expressions',
        'label' => 'Expressions',
        'kind' => 'reference',
        'checked' => 'Results of mutate(), grouped mutate(), and grouped summarise() expressions on all five backends: arithmetic, comparison and logic with NA, conditionals, rounding, strings, offsets, ranks, cumulative functions, and aggregates.',
        'description' => 'tests/r/expr.R evaluates each expression with dplyr on a 7-row table and writes the results. The PHP tests evaluate the same expressions on the same table in each backend.',
        'reference' => "dplyr {$r['versions']['dplyr']} and stringr {$r['versions']['stringr']}, on R {$r['versions']['R']}",
        'versions' => $rVersions('dplyr', 'stringr') + $backendVersions(),
        'inputs' => [['name' => 'expression cases', 'detail' => '7 rows, NA in every column', 'url' => 'tests/fixtures/expr/expected.json']],
        'comparison' => [
            ['id' => 'rounded', 'applies_to' => $rounded, 'kind' => 'exact'],
            ['id' => 'rounded-native', 'applies_to' => 'Polars column values; as above, with no fallback to a DataFrame', 'kind' => 'exact'],
        ],
        'exclusions' => ['round: not run on SQL databases. SQL ROUND does not round half to even; SqlTable evaluates round() in memory.'],
        'data' => 'tests/fixtures/expr/expected.json',
        'reproduce' => ['Rscript tests/r/expr.R', "{$withDatabases} {$suite} tests/ExprTest.php tests/SqlTest.php", "php -d extension=php_polars.so {$suite} tests/Polars/PolarsExprTest.php"],
        'match' => function (array $t) use ($backendOf, $caseLabel, $exprExpected) {
            if (! preg_match('/^matches dplyr for (grouped )?(mutate|summarise) expressions/', $t['test'], $m)) {
                return null;
            }
            $name = $caseLabel($t);

            return [
                'name' => $name,
                'implementation' => $backendOf($t),
                'quantity' => $m[1] !== '' ? 'grouped mutate' : $m[2],
                'rule' => $backendOf($t) === 'Polars' ? 'rounded-native' : 'rounded',
                'n_compared' => isset($exprExpected[$name]) ? count($exprExpected[$name]) : null,
            ];
        },
    ],
    'aggregate-types' => [
        'title' => 'Aggregate types',
        'label' => 'Aggregate types',
        'kind' => 'reference',
        'checked' => 'Result type of 22 aggregates in a grouped summarise() where every group holds only NA.',
        'description' => 'tests/r/expr-types.R records the column type dplyr gives each aggregate. tests/AggregateTypeTest.php runs the same summaries on a DataFrame.',
        'reference' => "dplyr {$r['versions']['dplyr']} summarise(), on R {$r['versions']['R']}",
        'versions' => $rVersions('dplyr') + ['PHP' => $runtime['PHP']],
        'inputs' => [['name' => 'all-NA table', 'detail' => '4 rows in 2 groups; NA double, integer, logical, character, and date columns', 'url' => 'tests/r/expr-types.R']],
        'comparison' => [['id' => 'type', 'applies_to' => 'Result type and values; type abbreviation (dbl, int, lgl, chr, date), every value NA', 'kind' => 'exact']],
        'data' => 'tests/fixtures/expr/types.json',
        'reproduce' => ['Rscript tests/r/expr-types.R', "{$suite} tests/AggregateTypeTest.php"],
        'match' => fn (array $t) => $t['file'] === 'tests/AggregateTypeTest.php' && $t['labels'] !== [] ? [
            'name' => $caseLabel($t),
            'quantity' => 'result type',
            'rule' => 'type',
            'expected' => $typeExpected[$caseLabel($t)] ?? null,
            'actual' => $t['status'] === 'pass' ? ($typeExpected[$caseLabel($t)] ?? null) : null,
        ] : null,
    ],
    'lubridate-stringr' => [
        'title' => 'Dates and strings',
        'label' => 'Dates and strings',
        'kind' => 'reference',
        'checked' => 'Date parsing, date parts, date rounding, periods, and time zones; string patterns, padding, truncation, and case. mutate() on all five backends.',
        'description' => 'tests/r/lubridate_stringr.R evaluates each case with lubridate and stringr and writes the results. The PHP tests evaluate the same expressions in each backend.',
        'reference' => "lubridate {$r['versions']['lubridate']} and stringr {$r['versions']['stringr']}, on R {$r['versions']['R']}",
        'versions' => $rVersions('lubridate', 'stringr') + $backendVersions(),
        'inputs' => [['name' => 'date and string cases', 'detail' => '5 rows of dates, datetimes, and text with NA; per-case vectors', 'url' => 'tests/fixtures/expr/lubridate_stringr.json']],
        'comparison' => [
            ['id' => 'rounded', 'applies_to' => 'Column values; dates as YYYY-MM-DD, datetimes as YYYY-MM-DD HH:MM:SS +hhmm in their time zone, numbers rounded to 9 decimal places, NA in identical positions', 'kind' => 'exact'],
            ['id' => 'rounded-native', 'applies_to' => 'Polars column values; as above, with no fallback to a DataFrame except str_to_title(), which requires ICU word breaks', 'kind' => 'exact'],
        ],
        'known_differences' => ['SQL databases: functions without a faithful SQL translation run in memory after the query. These cases are compared identically.'],
        'data' => 'tests/fixtures/expr/lubridate_stringr.json',
        'reproduce' => ['Rscript tests/r/lubridate_stringr.R', "{$withDatabases} {$suite} tests/LubridateStringrTest.php tests/SqlTest.php", "php -d extension=php_polars.so {$suite} tests/Polars/PolarsLubridateStringrTest.php"],
        'match' => function (array $t) use ($backendOf, $caseLabel, $lsExpected) {
            if (! str_starts_with($t['test'], 'matches lubridate and stringr')) {
                return null;
            }
            $name = $caseLabel($t);

            return [
                'name' => $name,
                'implementation' => $backendOf($t),
                'quantity' => 'mutate',
                'rule' => $backendOf($t) === 'Polars' ? 'rounded-native' : 'rounded',
                'n_compared' => isset($lsExpected[$name]) ? count($lsExpected[$name]) : null,
            ];
        },
    ],
    'join-by' => [
        'title' => 'Joins',
        'label' => 'Joins',
        'kind' => 'reference',
        'checked' => 'Output columns and rows of join_by() joins on all five backends: inequality, closest() rolling, between, within, and overlap conditions, across join types and the keep and naMatches options.',
        'description' => 'tests/r/joins.R runs each join with dplyr and writes the output. The PHP tests run the same joins on the same tables in each backend.',
        'reference' => "dplyr {$r['versions']['dplyr']} join_by(), on R {$r['versions']['R']}",
        'versions' => $rVersions('dplyr') + $backendVersions(),
        'inputs' => [['name' => 'join cases', 'detail' => 'Two tables with NA keys; two interval tables', 'url' => 'tests/fixtures/joins/expected.json']],
        'comparison' => [
            ['id' => 'ordered', 'applies_to' => 'Columns and rows in order; numbers as doubles, NA in identical positions', 'kind' => 'exact'],
            ['id' => 'unordered', 'applies_to' => 'Columns and sorted rows; SQL and Polars joins have no defined row order, Polars with no fallback to a DataFrame', 'kind' => 'exact'],
        ],
        'data' => 'tests/fixtures/joins/expected.json',
        'reproduce' => ['Rscript tests/r/joins.R', "{$withDatabases} {$suite} tests/ContractV1Test.php tests/SqlTest.php", "php -d extension=php_polars.so {$suite} tests/Polars/PolarsContractTest.php"],
        'match' => function (array $t) use ($backendOf, $caseLabel, $joinExpected) {
            if (! preg_match('/^matches dplyr join_by/', $t['test'])) {
                return null;
            }
            $name = $caseLabel($t);
            $expected = $joinExpected[$name] ?? null;

            return [
                'name' => $name,
                'implementation' => $backendOf($t),
                'quantity' => 'join',
                'rule' => $backendOf($t) === 'DataFrame' ? 'ordered' : 'unordered',
                'n_compared' => $expected === null ? null : count($expected['columns']) * count($expected['rows']),
            ];
        },
    ],
    'pivot-tidyr' => [
        'title' => 'Pivots',
        'label' => 'Pivots',
        'kind' => 'reference',
        'checked' => 'Output columns, rows, and warnings of pivotLongerSpec() and pivotWiderSpec(): NA dropping, multi-part names, value types, and duplicate keys.',
        'description' => 'tests/r/pivot.R writes each input, spec, and tidyr result. The PHP tests apply the same specs on a DataFrame and a PolarsTable.',
        'reference' => "tidyr {$r['versions']['tidyr']} pivot_longer_spec() and pivot_wider_spec(), on R {$r['versions']['R']}",
        'versions' => $rVersions('tidyr', 'dplyr') + array_filter(['PHP' => $runtime['PHP'], 'php_polars' => $runtime['php_polars']]),
        'inputs' => [['name' => 'pivot cases', 'detail' => 'Inputs, specs, and tidyr output', 'url' => 'tests/fixtures/pivot/cases.json']],
        'comparison' => [['id' => 'rows', 'applies_to' => 'Columns, rows in order, and warnings; numbers as doubles, a length-1 list cell as its value', 'kind' => 'exact']],
        'data' => 'tests/fixtures/pivot/cases.json',
        'reproduce' => ['Rscript tests/r/pivot.R', "{$suite} tests/PivotTest.php", "php -d extension=php_polars.so {$suite} tests/Polars/PolarsPivotTest.php"],
        'match' => fn (array $t) => str_starts_with($t['test'], 'matches tidyr pivot specs') ? [
            'name' => $caseLabel($t),
            'implementation' => $backendOf($t),
            'quantity' => $pivotCases[$caseLabel($t)]['kind'] === 'longer' ? 'pivot longer' : 'pivot wider',
            'rule' => 'rows',
            'n_compared' => isset($pivotCases[$caseLabel($t)]) ? count($pivotCases[$caseLabel($t)]['columns']) * count($pivotCases[$caseLabel($t)]['rows']) : null,
        ] : null,
    ],
    'expression-edge-cases' => [
        'title' => 'Expression edge cases',
        'label' => 'Expression edge cases',
        'kind' => 'reference',
        'checked' => 'Argument rules of row_number() and ntile(); isIn() with dates, datetimes, and times; NaN in coalesce(); one-character pads in str_pad(); parse_date_time() orders without a year; fractional periods; and dates plus clock periods. Results and error conditions on DataFrame, the SQL databases, and Polars.',
        'description' => "tests/r/edge_cases.R prints R's result or error for each case. The tests hold those results as expected values and check that phibble gives the same value, or raises where R raises.",
        'reference' => "R {$r['versions']['R']} with dplyr {$r['versions']['dplyr']}, stringr {$r['versions']['stringr']}, and lubridate {$r['versions']['lubridate']}",
        'versions' => $rVersions('dplyr', 'stringr', 'lubridate') + $backendVersions(),
        'inputs' => [['name' => 'edge cases', 'detail' => 'Literal vectors in tests/ExprRTest.php and tests/Polars/PolarsExprRTest.php', 'url' => 'tests/r/edge_cases.R']],
        'comparison' => [
            ['id' => 'value', 'applies_to' => 'Values and result types; NA in identical positions, datetimes to the microsecond', 'kind' => 'exact'],
        ],
        'known_differences' => [
            'parse_date_time() with an order that has a day but no month: lubridate returns NA with a warning; phibble raises an error.',
            'Errors where R errors: phibble raises an exception with its own message.',
        ],
        'exclusions' => ['isIn() with temporal lists on SQLite and coalesce() of numbers on PostgreSQL run in memory; the results are compared the same way.'],
        'data' => 'tests/r/edge_cases.R',
        'reproduce' => ['Rscript tests/r/edge_cases.R', "{$withDatabases} {$suite} tests/ExprRTest.php", "php -d extension=php_polars.so {$suite} tests/Polars/PolarsExprRTest.php"],
        'match' => fn (array $t) => in_array($t['file'], ['tests/ExprRTest.php', 'tests/Polars/PolarsExprRTest.php'], true) ? [
            'name' => preg_replace('/ in (SQL|Polars)\b/', '', $t['test']),
            'implementation' => str_starts_with($t['file'], 'tests/Polars/') ? 'Polars' : ($drivers[end($t['labels']) ?: ''] ?? 'DataFrame'),
            'rule' => 'value',
        ] : null,
    ],
    'csv-conformance' => [
        'title' => 'CSV conformance',
        'label' => 'CSV conformance',
        'kind' => 'contract',
        'checked' => 'Names, problem counts, and column values of the PHP CSV reader for 120 corpus cases, through the Phit\\read_csv() contract. Identical results at block sizes from 1 to 64 rows.',
        'description' => 'bin/generate-csv-conformance writes the PHP reader\'s results to the corpus. phit holds a byte-identical copy and checks its native reader against it. The CSV reading record compares these results with readr.',
        'versions' => ['PHP' => $runtime['PHP']],
        'inputs' => [['name' => 'CSV conformance corpus', 'detail' => '120 cases: delimiters, quoting, comments, blank lines, encodings, NA strings, type guessing, and declared types', 'url' => 'tests/fixtures/csv-conformance.json']],
        'comparison' => [['id' => 'corpus', 'applies_to' => 'Names, problem counts, column values, and types', 'kind' => 'exact']],
        'data' => 'tests/fixtures/csv-conformance.json',
        'reproduce' => ['bin/generate-csv-conformance', "{$suite} tests/CsvConformanceTest.php"],
        'match' => fn (array $t) => $t['file'] === 'tests/CsvConformanceTest.php' ? [
            'name' => match (true) {
                str_starts_with($t['test'], 'reads the corpus as') => $caseLabel($t),
                str_starts_with($t['test'], 'reads the corpus the same') => "block size {$caseLabel($t)}",
                default => $t['test'],
            },
            'quantity' => str_starts_with($t['test'], 'reads the corpus the same') ? 'all 120 cases' : null,
            'rule' => 'corpus',
        ] : null,
    ],
    'sql-parity' => [
        'title' => 'SQL parity',
        'label' => 'SQL parity',
        'kind' => 'integration',
        'checked' => 'SqlTable pipelines on SQLite, PostgreSQL, and MySQL against the same pipelines on a DataFrame: verbs, row order, window functions, joins, byte-order text, boolean aggregates, edge-case arithmetic, and driver column types.',
        'description' => 'Each test runs a pipeline as SQL, collects the result, and compares it with the DataFrame result or a fixed expectation.',
        'versions' => array_diff_key($backendVersions(), ['php_polars' => true]),
        'inputs' => 'Inline SELECT ... UNION ALL data in tests/SqlTest.php, tests/SqlReviewTest.php, and tests/DriverTypesTest.php; temporary tables only.',
        'comparison' => [
            ['id' => 'same', 'applies_to' => 'Rows, row order, types, generated SQL, or exception class; doubles rounded to 9 decimal places', 'kind' => 'exact'],
        ],
        'known_differences' => [
            'MySQL stores no Inf or NaN, and SQLite stores no NaN. These values return as NA and are compared as NA.',
            'Joins do not warn about unexpected many-to-many matches.',
        ],
        'reproduce' => "{$withDatabases} {$suite} tests/SqlTest.php tests/SqlReviewTest.php tests/DriverTypesTest.php",
        'match' => fn (array $t) => in_array($t['file'], ['tests/SqlTest.php', 'tests/SqlReviewTest.php', 'tests/DriverTypesTest.php'], true) ? [
            'name' => $t['test'].(count($t['labels']) > 1 ? ": {$t['labels'][0]}" : ''),
            'implementation' => $drivers[end($t['labels']) ?: ''] ?? null,
            'rule' => 'same',
        ] : null,
    ],
    'polars-backend' => [
        'title' => 'Polars backend',
        'label' => 'Polars backend',
        'kind' => 'contract',
        'checked' => 'PolarsTable against the Table contract: joins, grouping and group order, summarise .groups, factors, list-columns, type round trips, strict mode, and DataFrame fallback for closures and rowwise operations.',
        'description' => 'Each test runs a PolarsTable operation and compares it with the DataFrame result or a fixed expectation.',
        'versions' => array_filter(['PHP' => $runtime['PHP'], 'php_polars' => $runtime['php_polars']]),
        'inputs' => 'Tables defined in tests/Polars/.',
        'comparison' => [['id' => 'contract', 'applies_to' => 'Values, types, groups, and exceptions', 'kind' => 'exact']],
        'reproduce' => "php -d extension=php_polars.so {$suite} tests/Polars",
        'match' => fn (array $t) => str_starts_with($t['file'], 'tests/Polars/') ? [
            'name' => $t['test'],
            'quantity' => null,
            'rule' => 'contract',
        ] : null,
    ],
];

// Reference topics claim their tests first; the integration and contract
// topics take the rest of their files.
$claimed = [];
$records = [];
foreach ($topics as $id => $topic) {
    $cases = [];
    foreach ($tests as $i => $t) {
        if (isset($claimed[$i]) || ($case = $topic['match']($t)) === null) {
            continue;
        }
        $claimed[$i] = true;
        $row = ['name' => $case['name']];
        foreach (['implementation', 'quantity', 'rule', 'n_compared', 'actual', 'expected'] as $field) {
            if (($case[$field] ?? null) !== null) {
                $row[$field] = $case[$field];
            }
        }
        $row['status'] = $t['status'];
        if ($t['reason'] !== null) {
            $row['reason'] = $t['reason'];
        }
        $cases[] = $row;
    }
    unset($topic['match']);
    if (count($topic['comparison']) === 1) {
        $cases = array_map(function (array $c) {
            unset($c['rule']);

            return $c;
        }, $cases);
    }
    if ($topic['kind'] === 'reference') {
        $topic['description'] = trim(($topic['description'] ?? '').' '.$regenerated);
    }
    $records[$id] = $topic + ['cases' => $cases, 'environment' => $environment];
}

@mkdir('site/verifications');
foreach ($records as $id => $record) {
    file_put_contents("site/verifications/{$id}.json", json_encode($record, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n");
    $counts = array_count_values(array_column($record['cases'], 'status'));
    ksort($counts);
    fwrite(STDERR, sprintf("%-20s %s\n", $id, implode(', ', array_map(fn ($s, $n) => "{$n} {$s}", array_keys($counts), $counts))));
}

array_map(unlink(...), glob("{$logs}/*") ?: []);
@rmdir($logs);
