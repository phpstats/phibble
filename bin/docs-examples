#!/usr/bin/env php
<?php

/*
 * Run every docs/examples/*.php and write docs/examples/_<name>.md with the
 * example's code and its actual output, for Quarto to include. Examples run
 * with docs/data as the working directory, after a hidden prelude that
 * imports DataFrame, Type, SqlTable, the Phibble\ functions (tibble, tribble,
 * as_tibble, enframe, deframe, tbl) and every Phibble\Expr\ helper.
 *
 * An example that loads the autoloader itself, with
 * "require __DIR__.'/vendor/autoload.php';", is a complete script: it runs
 * without the prelude, with that line pointing at this repository's autoloader.
 *
 * Code above a line "// ---" and below a line "// ===" runs but is left out
 * of the page. Output after
 * a line "<!--phiz-->" is HTML, such as a phiz chart, and is included as is.
 * _<name>-code.md and _<name>-output.md hold the code and the output alone.
 *
 * Usage: bin/docs-examples [name ...]
 * Environment: PHP (the PHP 8.5 binary, default: this one).
 */

declare(strict_types=1);

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

$pages = implode("\n", array_map(file_get_contents(...), [...glob($root.'/docs/*.qmd'), ...glob($root.'/docs/examples/*.qmd')]));
$split = fn (string $name) => str_contains($pages, "_{$name}-code.md") || str_contains($pages, "_{$name}-output.md");

$functions = fn (string $namespace) => array_values(array_filter(
    get_defined_functions()['user'],
    fn (string $f) => str_starts_with($f, strtolower($namespace).'\\')
        && ! str_contains(substr($f, strlen($namespace) + 1), '\\')
        && ! str_starts_with((new ReflectionFunction($f))->getShortName(), 'call_with'),
));
$short = fn (array $fs) => array_map(fn (string $f) => (new ReflectionFunction($f))->getShortName(), $fs);

$phibble = $short($functions('Phibble'));
$expr = $short($functions('Phibble\\Expr'));
sort($phibble);
sort($expr);
$prelude = "use Phibble\\DataFrame;\nuse Phibble\\Type;\nuse Phibble\\Sql\\SqlTable;\n"
    ."use function Phibble\\{".implode(', ', $phibble)."};\n"
    ."use function Phibble\\Expr\\{".implode(', ', $expr)."};\n";

$php = getenv('PHP') ?: PHP_BINARY;

$only = array_slice($argv, 1);
$failed = 0;
foreach (glob($root.'/docs/examples/*.php') as $file) {
    $name = basename($file, '.php');
    if ($only !== [] && ! in_array($name, $only, true)) {
        continue;
    }
    $code = trim((string) preg_replace('/^<\?php\s*(declare\(strict_types=1\);\s*)?/', '', file_get_contents($file)));
    $script = tempnam(sys_get_temp_dir(), 'phibble-doc').'.php';
    $autoload = 'require '.var_export($root.'/vendor/autoload.php', true).';';
    $standalone = "require __DIR__.'/vendor/autoload.php';";
    file_put_contents($script, str_contains($code, $standalone)
        ? "<?php\n\ndeclare(strict_types=1);\n\n".str_replace($standalone, $autoload, $code)."\n"
        : "<?php\n\ndeclare(strict_types=1);\n\n{$autoload}\n\n".$prelude."\n".$code."\n");
    $proc = proc_open([$php, $script], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $root.'/docs/data');
    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);
    $status = proc_close($proc);
    unlink($script);
    if ($status !== 0 || trim($err) !== '') {
        fwrite(STDERR, "{$name}: failed\n{$out}{$err}\n");
        $failed++;

        continue;
    }
    // Code above a "// ---" line runs but is not shown (setup such as a database).
    $shown = preg_match('~^// ---\s*$~m', $code) ? trim((string) preg_split('~^// ---\s*$~m', $code, 2)[1]) : $code;
    // Code below a "// ===" line runs but is not shown (output plumbing).
    $shown = preg_match('~^// ===\s*$~m', $shown) ? trim((string) preg_split('~^// ===\s*$~m', $shown, 2)[0]) : $shown;
    // A complete script is shown with its opening tag, ready to save and run.
    if (str_contains($code, $standalone)) {
        $shown = "<?php\n\n{$shown}";
    }
    $md = "```php\n{$shown}\n```\n\n";
    // Output after a "<!--phiz-->" line is HTML (a rendered chart), included as is.
    [$text, $html] = str_contains($out, "<!--phiz-->\n") ? explode("<!--phiz-->\n", $out, 2) : [$out, ''];
    if (trim($text) !== '') {
        $md .= "```{.text .output}\n".rtrim($text)."\n```\n";
    }
    if (trim($html) !== '') {
        $md .= "\n```{=html}\n".trim($html)."\n```\n";
    }
    file_put_contents($root."/docs/examples/_{$name}.md", $md);
    // The code and the output alone, for tabsets that show one output below
    // several versions of the code; written only for examples a page includes.
    if ($split($name)) {
        file_put_contents($root."/docs/examples/_{$name}-code.md", "```php\n{$shown}\n```\n");
        file_put_contents($root."/docs/examples/_{$name}-output.md", substr($md, strlen("```php\n{$shown}\n```\n\n")));
    }
    echo "{$name}: ok\n";
}
exit($failed > 0 ? 1 : 0);
