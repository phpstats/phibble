#!/usr/bin/env bash
# Refresh example output, render the Quarto site, then copy it into docs/,
# where phpstats.org imports the rendered pages.
set -euo pipefail
cd "$(dirname "$0")/.."
"${PHP:-php}" bin/docs-examples
"${QUARTO:-quarto}" render docs
python3 - <<'PY'
from pathlib import Path
import os
import shutil
import tempfile

root = Path('docs')
site = root / '_site'
if not (site / 'index.html').is_file():
    raise SystemExit('Quarto did not produce index.html')
for source in site.rglob('*'):
    if not source.is_file():
        continue
    destination = root / source.relative_to(site)
    if destination.exists() and destination.read_bytes() == source.read_bytes():
        continue
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False) as file:
        temporary = Path(file.name)
    try:
        shutil.copy2(source, temporary)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
(root / '.nojekyll').touch()
print('Published rendered documentation to docs/index.html')
PY
