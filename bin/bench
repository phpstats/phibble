#!/usr/bin/env php
<?php

/*
 * Benchmark Table backends on the data from bench/generate.php.
 *
 * Usage: bin/bench [--backend=dataframe|sqlite|polars|Some\\Backend\\Class] [--bootstrap=file.php]
 *                  [--data=dir] [--runs=3] [--csv-reader=php|native] [workload ...]
 *
 * Another package can benchmark its own backend: implement
 * Phibble\Bench\Backend, then run vendor/phpstats/phibble/bin/bench with
 * --bootstrap pointing at a file that loads it (or its vendor/autoload.php)
 * and --backend set to the class name.
 *
 * --csv-reader=php turns off the phit extension's native CSV reader, which
 * phibble otherwise uses when phit is loaded. The workload "load" times
 * loading the input tables into the backend.
 *
 * Prints one JSON line per workload: backend, workload, rows, every run's
 * seconds, their median and min, and PHP's allocator peak in MiB for the
 * whole process. bin/bench-record runs this under peakmem and writes the
 * records in site/benchmarks/.
 */

declare(strict_types=1);

// Works from a phibble checkout and from vendor/phpstats/phibble.
foreach ([dirname(__DIR__).'/vendor/autoload.php', dirname(__DIR__, 3).'/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}
// The bench classes are autoload-dev, so load them directly when installed as a dependency.
foreach (['Backend', 'DataFrameBackend', 'SqliteBackend', 'PolarsBackend', 'Workloads'] as $class) {
    if (! class_exists("Phibble\\Bench\\{$class}") && ! interface_exists("Phibble\\Bench\\{$class}")) {
        require_once dirname(__DIR__)."/bench/src/{$class}.php";
    }
}

use Phibble\Bench\DataFrameBackend;
use Phibble\Bench\PolarsBackend;
use Phibble\Bench\SqliteBackend;
use Phibble\Bench\Workloads;
use Phibble\Io\NativeCsv;

ini_set('memory_limit', '-1');

$options = getopt('', ['backend:', 'runs:', 'bootstrap:', 'data:', 'csv-reader:'], $rest);
if (isset($options['bootstrap'])) {
    require $options['bootstrap'];
}
$backendName = $options['backend'] ?? 'dataframe';
$runs = (int) ($options['runs'] ?? 3);
$only = array_slice($argv, $rest);
$data = $options['data'] ?? dirname(__DIR__).'/bench/data';
if (! is_file("{$data}/events.csv")) {
    fwrite(STDERR, "No data. Run: php bench/generate.php [rows]\n");
    exit(1);
}
$csvReader = $options['csv-reader'] ?? 'native';
NativeCsv::enable($csvReader !== 'php');

$time = function (Closure $work) use ($runs): array {
    $times = [];
    $result = null;
    for ($i = 0; $i < $runs; $i++) {
        gc_collect_cycles();
        $start = hrtime(true);
        $result = $work();
        $times[] = (hrtime(true) - $start) / 1e9;
    }

    return [$times, $result];
};
$report = function (string $workload, array $timing) use ($backendName, $csvReader): void {
    [$times, $rows] = $timing;
    $sorted = $times;
    sort($sorted);
    echo json_encode([
        'backend' => $backendName,
        'workload' => $workload,
        'csv_reader' => NativeCsv::available() ? 'native' : 'php',
        'rows' => $rows,
        'seconds' => $times,
        'median_s' => round($sorted[intdiv(count($sorted), 2)], 3),
        'min_s' => round($sorted[0], 3),
        'php_peak_mib' => round(memory_get_peak_usage(true) / 2 ** 20, 1),
    ]), "\n";
};

if ($backendName === 'dataframe') {
    foreach (Workloads::csv() as $name => $setup) {
        if ($only === [] || in_array($name, $only, true)) {
            $report($name, $time($setup("{$data}/events.csv")));
        }
    }
}

$tableWorkloads = array_filter(Workloads::all(), fn ($name) => $only === [] || in_array($name, $only, true), ARRAY_FILTER_USE_KEY);
if ($tableWorkloads === [] && ! in_array('load', $only, true)) {
    exit(0);
}

$backend = match ($backendName) {
    'dataframe' => new DataFrameBackend(),
    'sqlite' => new SqliteBackend(),
    'polars' => new PolarsBackend(),
    default => class_exists($backendName) && is_subclass_of($backendName, Phibble\Bench\Backend::class)
        ? new $backendName()
        : throw new InvalidArgumentException("Unknown backend {$backendName}: use dataframe, sqlite, polars, or a class implementing Phibble\\Bench\\Backend."),
};

if (in_array('load', $only, true)) {
    $report('load', $time(function () use ($backend, $data) {
        $backend->load("{$data}/dims.csv");

        return $backend->load("{$data}/events.csv")->nrow();
    }));
}
if ($tableWorkloads === []) {
    exit(0);
}

$events = $backend->load("{$data}/events.csv");
$dims = $backend->load("{$data}/dims.csv");

foreach ($tableWorkloads as $name => $work) {
    $report($name, $time(fn () => $work($events, $dims)));
}
