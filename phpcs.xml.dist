<?xml version="1.0"?>
<ruleset name="phibble">
    <description>The phpstats naming conventions. Nothing else is enforced here: this is not a formatting standard.</description>

    <file>bench</file>
    <file>docs</file>
    <file>src</file>
    <file>tests</file>
    <file>tools/phpcs/Phpstats</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Methods are camelCase, classes are PascalCase, and class constants
         are UPPER_SNAKE. PHPCS ships a sniff for each of the three. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName"/>
    <rule ref="Squiz.Classes.ValidClassName"/>
    <rule ref="Generic.NamingConventions.UpperCaseConstantName"/>

    <!-- Standalone functions are snake_case in this family, so the sniff that
         demands camelCase for them is switched off rather than left out.
         Leaving it out would let any later ruleset turn it back on. -->
    <rule ref="Generic.NamingConventions.CamelCapsFunctionName">
        <severity>0</severity>
    </rule>

    <!-- The two rules PHPCS has no sniff for. The sniffs live in this
         repository because a package may not reference the family checkout or
         a sibling package in anything it runs in CI. -->
    <rule ref="./tools/phpcs/Phpstats/Sniffs/NamingConventions/SnakeCaseFunctionNameSniff.php">
        <!-- A test or benchmark file names its local helpers in the idiom of
             the suite it belongs to, and the conventions do not reach internal
             code. Everything the package ships is still checked. -->
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>bench/*</exclude-pattern>
        <exclude-pattern>benchmarks/*</exclude-pattern>
        <!-- A name that collides with a PHP reserved word takes a trailing
             underscore. R's sample variance var() is the one case here. -->
        <properties>
            <property name="allowed" type="array">
                <element value="var_"/>
            </property>
        </properties>
    </rule>
    <rule ref="./tools/phpcs/Phpstats/Sniffs/NamingConventions/CamelCapsParameterAndPropertySniff.php">
        <!-- Joiner is @internal, and in its private static helpers the case is
             what tells the two operands apart: $x and $y are the PolarsTables
             and $X and $Y the PolarsDataFrames built from them, in the usual
             notation for a pair of design matrices. -->
        <properties>
            <property name="allowed" type="array">
                <element value="X"/>
                <element value="Y"/>
            </property>
        </properties>
    </rule>
</ruleset>
